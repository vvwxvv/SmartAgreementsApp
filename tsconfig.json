{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*",
        "./utils/*",
        "./*"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/app/test/page.js",
    "src/components/navs/DotMenu.jsx",
    "src/components/patterns/FieldPattern.jsx",
    "src/components/patterns/FlowPattern.jsx",
    "src/components/patterns/FractalPattern.jsx",
    "src/components/patterns/RadialPattern.jsx",
    "src/components/patterns/SpiralPattern.jsx",
    "src/hooks/useAsyncAction.js",
    ".next-mongo/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
